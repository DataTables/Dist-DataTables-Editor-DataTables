<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>3.0.1</version>
        <id>datatables.net-editor-dt</id>
        <description>This is Editor for DataTables with styling for [DataTables](https://datatables.net/)</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>https://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>Editing  CRUD  Inline  Modal  Multi-row   Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-editor" version="3.0.1"/>
            <dependency id="datatables.net-dt" version="[3.0.0, 4.0.0)"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/editor.dataTables.js" target="content\Scripts"/>
        <file src="js/editor.dataTables.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/editor.dataTables.min.js" target="content\Scripts"/>
        <file src="js/editor.dataTables.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/editor.dataTables.min.mjs" target="content\Scripts"/>
        <file src="js/editor.dataTables.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/editor.dataTables.mjs" target="content\Scripts"/>
        <file src="js/editor.dataTables.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/editor.dataTables.css" target="content\Content"/>
        <file src="css/editor.dataTables.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/editor.dataTables.min.css" target="content\Content"/>
        <file src="css/editor.dataTables.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
